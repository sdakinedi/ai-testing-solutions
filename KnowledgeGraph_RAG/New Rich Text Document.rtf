\af2\afs20 \ltrch\fcs0 \f2\fs20\insrsid4473148\charrsid4473148 def retrieve_related_entities_with_scores(self, tx, entity_names, question_embedding):
\par     """Score entities by relevance"""
\par     cypher_query = """
\par     MATCH (e1) WHERE e1.name IN $entities
\par     MATCH (e1)-[r]-(e2)
\par     MATCH (c:Chunk)-[:MENTIONS]->(e2)
\par     WITH e2, r, c, 
\par          gds.similarity.cosine(c.embedding, $query_embedding) as score
\par     RETURN DISTINCT e2.name as entity, 
\par                     type(r) as relationship, 
\par                     avg(score) as relevance_score
\par     ORDER BY relevance_score DESC
\par     LIMIT 10
\par     """
\par     result = tx.run(
\par         cypher_query, 
\par         entities=entity_names, 
\par         query_embedding=question_embedding
\par     )
\par     return [(record["entity"], record["relationship"], record["relevance_score"]) 
\par             for record in result]
\par }\pard \ltrpar\ql \li0\ri0\widctlpar\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid4473148 {\rtlch\fcs1 \af0\afs24 \ltrch\fcs0 \f0\fs24\insrsid4473148\charrsid4473148 
